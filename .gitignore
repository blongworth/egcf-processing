# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data (raw and processed) -- not tracked in git, except the snapshot the
# deployed dashboard reads: only the Parquet tables dashboard.py uses.
/data/*
!/data/processed/
/data/processed/*
!/data/processed/egcf_*/
