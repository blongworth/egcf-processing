!/data/processed/egcf_*/status.parquet
!/data/processed/egcf_*/system_health.parquet
!/data/processed/egcf_*/rga.parquet
!/data/processed/egcf_*/scalup.parquet
!/data/processed/egcf_*/valve.parquet
!/data/processed/egcf_*/par.parquet
!/data/processed/egcf_*/hobo_oxygen.parquet
!/data/processed/egcf_*/egcf_chamber_cycles.parquet
!/data/processed/egcf_*/egcf_pi_fit.parquet

# Machine-specific settings overriding egcf.toml
egcf.local.toml

# OS cruft
.DS_Store
